         <dc:identifier>info:doi/XXXXXXX.XXXXXXX</dc:identifier>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="en">Identity-Preserving Face Swapping via Dual Surrogate Generative Models</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="en">-  Computing methodologies  -&gt;  Image manipulation.</rdf:li>
